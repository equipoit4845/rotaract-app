{
  "name": "mirotaract-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm build && pnpm --filter @mirotaract/institutional-kernel-api test:integration",
    "test:contract": "pnpm --filter @mirotaract/institutional-kernel-api test:contract",
    "test:live": "pnpm test:integration",
    "contracts:openapi": "node scripts/validate-openapi.mjs",
    "contracts:events": "node scripts/validate-events-contract.mjs",
    "contracts:http": "node scripts/validate-http-operations.mjs",
    "contracts:design-system-boundaries": "node scripts/validate-design-system-boundaries.mjs",
    "contracts:events-catalog": "tsx apps/institutional-kernel-api/scripts/generate-events-catalog.ts --check",
    "contracts:validate": "pnpm contracts:openapi && pnpm contracts:events && pnpm contracts:events-catalog && pnpm contracts:http && pnpm contracts:design-system-boundaries",
    "quickstarts:check": "pnpm --filter @mirotaract/sdk build && node scripts/check-quickstarts.mjs",
    "docs:events": "tsx apps/institutional-kernel-api/scripts/generate-events-catalog.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @equipoit4845/design-tokens --filter @equipoit4845/icons --filter @equipoit4845/ui --filter @equipoit4845/admin-shell build && changeset publish",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @mirotaract/institutional-kernel-api prisma:generate",
    "db:migrate": "pnpm --filter @mirotaract/institutional-kernel-api prisma:migrate",
    "db:deploy": "pnpm --filter @mirotaract/institutional-kernel-api prisma:deploy",
    "db:seed": "pnpm --filter @mirotaract/institutional-kernel-api prisma:seed",
    "db:seed:synthetic": "tsx prisma/seed-synthetic.ts",
    "db:seed:legacy:dry-run": "tsx prisma/seed-legacy.ts",
    "db:seed:legacy": "tsx prisma/seed-legacy.ts --apply",
    "db:seed:current-presidents:dry-run": "tsx prisma/seed-current-presidents.ts",
    "db:seed:current-presidents": "tsx prisma/seed-current-presidents.ts --apply",
    "llms": "node scripts/build-llms-txt.mjs",
    "test:llms": "node --test scripts/test/*.test.mjs",
    "skills:build": "pnpm --filter @mirotaract/ai-skills build",
    "evals": "node evals/bin/evals.js",
    "evals:gate": "node evals/bin/evals.js gate"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@changesets/cli": "^2.31.1",
    "@prisma/client": "^6.10.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "^3.5.3",
    "prisma": "^6.10.1",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  }
}
