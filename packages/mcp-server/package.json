{
  "name": "@mirotaract/mcp",
  "version": "0.1.0",
  "description": "Servidor MCP oficial de Mi Rotaract (stdio): documentación, contrato OpenAPI, permisos, eventos, manifiestos de módulo y tipos; app y tokens de prueba solo contra un kernel local.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mirotaract-mcp": "./bin/mirotaract-mcp.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./bundle": "./src/bundle.js",
    "./manifest": "./src/manifest.js",
    "./sandbox": "./src/sandbox.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "dist/bundle.json",
    "examples",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "test": "node scripts/build-bundle.mjs && node --test --test-force-exit test/*.test.mjs",
    "lint": "prettier --check src bin scripts test"
  },
  "dependencies": {
    "@mirotaract/cli": "workspace:*",
    "@mirotaract/module-manifest": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "author": "Distrito 4845 de Rotaract",
  "homepage": "https://developers.rotaract4845.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equipoit4845/rotaract-app.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/equipoit4845/rotaract-app/issues"
  },
  "keywords": [
    "mirotaract",
    "rotaract",
    "mcp",
    "ai"
  ]
}
