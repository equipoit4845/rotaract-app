{
  "name": "@mirotaract/ai-skills",
  "version": "0.1.0",
  "description": "Skills de IA de Mi Rotaract: Claude Code, Cursor, GitHub Copilot y AGENTS.md desde una sola fuente, con el checklist de seguridad.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mirotaract-ai-skills": "./bin/ai-skills.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./master-prompt": "./src/master-prompt.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "skills-src",
    "prompts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node bin/ai-skills.js build --out dist",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "gate": "node ../../evals/bin/evals.js gate",
    "prepublishOnly": "node ../../evals/bin/evals.js gate",
    "lint": "prettier --check src bin test"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "author": "Distrito 4845 de Rotaract",
  "homepage": "https://developers.rotaract4845.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equipoit4845/rotaract-app.git",
    "directory": "packages/ai-skills"
  },
  "bugs": {
    "url": "https://github.com/equipoit4845/rotaract-app/issues"
  },
  "keywords": [
    "mirotaract",
    "rotaract",
    "ai",
    "skills"
  ]
}
