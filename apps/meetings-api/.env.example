# meetings-api (Reuniones distritales). In docker-compose these come from the
# root .env (see the meetings-api service block).

PORT=3003
# Own database "meetings" on the shared postgres (created by meetings-db-init).
MEETINGS_DATABASE_URL=postgresql://kernel:change-me@127.0.0.1:5432/meetings
# HS256 secret shared with meetings-web (>= 32 chars). Tokens: aud=meetings-api, iss=meetings-web.
MEETINGS_TOKEN_SECRET=
# Local filesystem storage for meeting attachments.
MEETINGS_UPLOAD_DIR=./uploads
# Dev only (production is same-origin): comma-separated allowed origins.
MEETINGS_CORS_ORIGIN=http://localhost:3002

# Kernel directory sync (client_credentials app with kernel.service.organizations.read,
# memberships.read, authorities.read, persons.read and persons.contact.read).
KERNEL_API_URL=http://127.0.0.1:3001/api/kernel/v1
KERNEL_CLIENT_ID=
KERNEL_CLIENT_SECRET=
# MEETINGS_DIRECTORY_SYNC=off            # serve only from the local tables
# MEETINGS_DIRECTORY_SYNC_INTERVAL_MS=300000
# KERNEL_HTTP_TIMEOUT_MS=15000

# Acta AI (Gemini gemini-2.5-flash if set, else OpenAI gpt-4o-mini) and Whisper transcription.
GEMINI_API_KEY=
OPENAI_API_KEY=

# scripts/migrate-legacy.ts (read-only sources)
# LEGACY_DATABASE_URL=postgresql://rotaract:...@127.0.0.1:5433/mi_rotaract
# KERNEL_DATABASE_URL=postgresql://kernel:...@127.0.0.1:5432/institutional_kernel
