{
  "name": "@mirotaract/correo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Correo Distrital: casillas @rotaract4845.com de las autoridades distritales, atadas al mandato (módulo `correo` del Institutional Kernel)",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "prettier --check src",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc --noEmit",
    "test": "prisma generate --schema prisma/schema.prisma && jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "module:check": "mirotaract-module check mirotaract.module.json"
  },
  "dependencies": {
    "@clickmail/sdk": "github:facuma/clickmail-sdk#9848a25",
    "@mirotaract/sdk": "workspace:*",
    "@nestjs/common": "^10.4.9",
    "@nestjs/core": "^10.4.9",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.9",
    "@prisma/client": "^6.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@mirotaract/module-manifest": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.9",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
