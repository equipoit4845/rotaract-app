# --- "Ingresar con Mi Rotaract" (CONFIDENTIAL kernel app) ---
# Kernel API base URL = OIDC issuer.
MIROTARACT_ISSUER=https://api.rotaract4845.com/api/kernel/v1
MIROTARACT_CLIENT_ID=mra_xxx
MIROTARACT_CLIENT_SECRET=mrs_xxx
MIROTARACT_REDIRECT_URI=https://reuniones.rotaract4845.com/auth/callback
# Encrypts the session cookie (>= 32 chars).
SESSION_SECRET=change-me-change-me-change-me-change-me

# --- meetings-api ---
# Shared with meetings-api (>= 32 chars): signs the 15-min meetings token.
MEETINGS_TOKEN_SECRET=change-me-too-change-me-too-change-me-too
# Dev only: Next rewrites /meetings-api/* and /socket.io/* here (read at build time).
MEETINGS_API_INTERNAL_URL=http://localhost:3003
# Browser side. Empty = same origin (production behind cloudflared).
NEXT_PUBLIC_MEETINGS_API_URL=
NEXT_PUBLIC_MEETINGS_SOCKET_URL=

# Link back to the main app.
NEXT_PUBLIC_MIROTARACT_URL=https://app.rotaract4845.com
