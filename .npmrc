auto-install-peers=true
strict-peer-dependencies=false

# Only consulted when actually publishing/installing @equipoit4845/* from
# outside this workspace — local dev resolves them via workspace:* and
# never hits a registry. The publish workflow supplies the auth token
# itself (see .github/workflows/design-system-release.yml); it isn't
# checked in here so a plain `pnpm install` never warns about a missing
# NODE_AUTH_TOKEN. Scope is @equipoit4845 (the GitHub org that owns this
# repo), not @mirotaract — GitHub Packages requires the npm scope to match
# the repository owner.
@equipoit4845:registry=https://npm.pkg.github.com
