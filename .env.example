POSTGRES_USER=kernel
POSTGRES_PASSWORD=kernel_dev_only
POSTGRES_DB=institutional_kernel
KERNEL_DATABASE_URL=postgresql://kernel:kernel_dev_only@postgres:5432/institutional_kernel?schema=public
KERNEL_DIRECT_URL=postgresql://kernel:kernel_dev_only@postgres:5432/institutional_kernel?schema=public
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
JWT_SECRET=replace-with-a-long-random-secret
KERNEL_SERVICE_API_KEY=replace-with-a-service-secret
KERNEL_SUPERADMIN_EMAIL=admin@example.test
KERNEL_SUPERADMIN_PASSWORD=replace-with-a-long-password
NEXT_PUBLIC_KERNEL_API_URL=http://localhost:3001/api/kernel/v1
CLICKMAIL_API_KEY=
CLICKMAIL_BASE_URL=http://localhost:3000
CLICKMAIL_FROM_ADDRESS=Mi Rotaract <no-reply@mirotaract.org>
KERNEL_PUBLIC_WEB_URL=http://localhost:3000
# Opt-in runtime boundary checks. Enable both in staging/contract CI; keep
# response validation disabled temporarily only while diagnosing a divergence.
KERNEL_OPENAPI_RUNTIME_VALIDATION=false
KERNEL_OPENAPI_RESPONSE_VALIDATION=false
# Optional explicit path; Docker already includes kernel-openapi.yaml at /workspace.
KERNEL_OPENAPI_PATH=
